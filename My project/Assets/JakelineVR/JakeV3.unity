  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "El rond\xF3n (Rundown) es uno de los platos m\xE1s representativos de
    San Andr\xE9s, Providencia y Santa Catalina, y una expresi\xF3n de la herencia
    cultural del pueblo raizal. Su origen est\xE1 ligado a las tradiciones afrocaribe\xF1as
    e inglesas de las islas, donde las familias preparaban este guiso al aire libre,
    aprovechando los productos del mar y los cultivos de la tierra. Su nombre proviene
    de la expresi\xF3n inglesa run down, relacionada con la forma en que los ingredientes
    se cocinan lentamente en leche de coco hasta que el l\xEDquido se reduce."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 179d163e4fe7a544d812ef12109eb3fa, type: 2}
  m_sharedMaterial: {fileID: -8912931025705057404, guid: 179d163e4fe7a544d812ef12109eb3fa, type: 2}
